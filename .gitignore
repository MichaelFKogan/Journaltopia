# macOS
.DS_Store

# Xcode user data
xcuserdata/
*.xcuserstate
*.xcworkspace/xcuserdata/

# Xcode build files
build/
DerivedData/

# Swift Package Manager
.build/
Packages/

# Local Supabase configuration
Config/Supabase.xcconfig

# CocoaPods (only if using Pods)
Pods/

# Fastlane (optional)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Misc
*.swp
*.lock

# Local Supabase configuration
Supabase.xcconfig
Config/Supabase.xcconfig

# Supabase CLI local state
supabase/.temp/

# Edge Function secrets. The OpenAI key and the Apple verification configuration live here locally
# and in `supabase secrets set` when deployed. supabase/functions/.env.example documents the names
# and is committed; anything holding actual values is not.
.env
.env.local
supabase/functions/.env
supabase/functions/.env.local

# Xcode project recovery backups
*.deleted-target-backup

# Local media recovery artifacts and storage snapshots
media-repair/