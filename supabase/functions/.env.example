# Edge Function configuration. Names only — no values are committed.
#
# Local:      copy to supabase/functions/.env, fill in, and `supabase functions serve` picks it up.
# Deployed:   `supabase secrets set NAME=value` for each.
#
# supabase/functions/.env must never be committed. Check .gitignore before creating it.

# --- Storyboard generation (already in use) ---------------------------------------------------
OPENAI_API_KEY=
# Optional. Defaults to gpt-image-2.
OPENAI_IMAGE_MODEL=

# --- Apple subscription verification (Phase 3) -------------------------------------------------

# Apple Root CA - G3, base64-encoded DER, from https://www.apple.com/certificateauthority/
# (download AppleRootCA-G3.cer, then `base64 -i AppleRootCA-G3.cer | tr -d '\n'`).
#
# Public data, not a secret, but it is the trust anchor for every entitlement decision the server
# makes — so it is configured rather than pasted into source, where a wrong byte would be invisible
# and where rotating it would mean a code change. Comma-separate to trust more than one root.
APPLE_ROOT_CA_G3_BASE64=

# The app's bundle identifier, exactly as in App Store Connect. Apple's verifier rejects a signed
# transaction whose bundle id does not match this. For Journaltopia, set this to
# com.michaelkogan.Journaltopia.
APPLE_BUNDLE_ID=

# The app's numeric Apple ID (App Store Connect > App Information > General Information > Apple ID).
# Required for production verification; optional for sandbox-only testing.
APPLE_APP_APPLE_ID=

# Set to "false" only for local testing, where there is no route to Apple's OCSP responder to check
# whether the signing certificates have been revoked. Leave unset in any deployed environment.
APPLE_VERIFICATION_ONLINE_CHECKS=

# --- Account deletion --------------------------------------------------------------------------
#
# `delete-account` uses SUPABASE_SERVICE_ROLE_KEY, which the platform injects, to delete the auth user
# and to sweep the caller's private Storage objects.
#
# Deleting an account that signed in with Apple must also revoke Journaltopia's Sign in with Apple
# authorization (App Store Review Guideline 5.1.1(v)), which needs the three values below plus
# APPLE_BUNDLE_ID above — the bundle id doubles as the `client_id` and as the `sub` of the client
# secret. Without these, deletion of an Apple-linked account fails loudly rather than completing
# without revoking; Google and email-only accounts are unaffected and need none of it.

# Your 10-character Team ID. Apple Developer > Membership details. Becomes `iss` in the client secret.
APPLE_TEAM_ID=

# The 10-character Key ID of a "Sign in with Apple" key.
# Apple Developer > Certificates, Identifiers & Profiles > Keys > (your key). Becomes `kid`.
APPLE_SIGN_IN_KEY_ID=

# The contents of that key's AuthKey_XXXXXXXXXX.p8 file, which Apple lets you download exactly once.
# Paste the whole file including the BEGIN/END lines; the escaped single-line form works too.
#
# This is a private key. It belongs here and only here — never in the iOS app, never in an xcconfig,
# never in git. Everything the app sends is a short-lived, single-use authorization code that is
# worthless without this key.
APPLE_SIGN_IN_PRIVATE_KEY=
#
# Worth stating because it is the security property of the whole feature: that key exists only here,
# in the Edge Function environment. It is not in the iOS app, not in any xcconfig, and not in git.
# The app authenticates as the user and can only ever ask to delete itself.

# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by the platform and do
# not belong here.
